# Every provider below is optional — Yahoo Finance and TradingView work with no
# configuration at all.

# Finnhub: free key at https://finnhub.io/register
FINNHUB_API_KEY=

# Financial Modeling Prep: free key at https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Zacks analyst ratings, licensed via Intrinio: free key at https://intrinio.com
# Free-tier request quotas are small — fine for a subset of the universe
# (--symbols or --limit on npm run refresh), tight for a full daily run.
INTRINIO_API_KEY=

# Benzinga: free key at https://www.benzinga.com/apis
# Returns individual analyst rating actions, which Stockr turns into a
# consensus itself (see src/providers/benzinga.ts). Coverage skews US/cross-listed.
BENZINGA_API_KEY=

# TipRanks: no key, but bot protection rejects datacentre IPs intermittently.
# Set to 1 to try it anyway.
TIPRANKS_ENABLED=

# How many days a hand-entered row in data/manual-ratings.csv stays valid.
MANUAL_MAX_AGE_DAYS=45
